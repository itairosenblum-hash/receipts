rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email == 'itai.rosenblum@gmail.com';
    }

    function isAllowed() {
      return isAdmin() || (
        request.auth != null
        && request.auth.token.email_verified
        && exists(/databases/$(database)/documents/config/access)
        && request.auth.token.email in
           get(/databases/$(database)/documents/config/access).data.emails
      );
    }

    // רשימת מורשים והגדרות: קריאה למורשים, כתיבה למנהל
    match /config/{doc} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }

    // קבלות
    match /receipts/{id} {
      allow read, update, delete: if isAllowed();
      allow create: if isAllowed()
        && request.resource.data.createdBy == request.auth.token.email;
    }

    // קטגוריות ותיקוני סיווג
    match /categories/{id} {
      allow read, write: if isAllowed();
    }
    match /corrections/{id} {
      allow read, create: if isAllowed();
    }

    // טוקני התראות: כל משתמש מנהל רק את שלו
    match /tokens/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }

    // כל השאר חסום
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
